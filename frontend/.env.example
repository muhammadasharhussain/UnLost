# ============================================================
# Lost & Found App — Environment Variables Template
# ============================================================
# 1. Copy this file:   cp .env.example .env
# 2. Fill in your key below (the .env file is git-ignored).
# 3. At runtime the app reads the key from flutter_secure_storage,
#    not directly from this file. See lib/services/groq/ for details.
# ============================================================

# Groq Cloud API key — get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

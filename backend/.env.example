# Copy this file to .env and fill in your real values.
# .env is gitignored — NEVER commit .env with real secrets.

# The port our Express server listens on
PORT=3000

# MongoDB Atlas connection string — get this from your Atlas dashboard
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/unlost

# JWT Secret — a long random string used to sign tokens
# Anyone with this string can forge tokens, so keep it secret
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# How long until a JWT token expires (7d = 7 days)
JWT_EXPIRES_IN=7d
